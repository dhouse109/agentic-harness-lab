{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "batch-recommendations.schema.json",
  "title": "Assembled recommendation evidence",
  "type": "object",
  "required": ["schema_version", "run_id", "source_framework", "recommendations"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^drupal_ai-[0-9]{8}T[0-9]{6}Z-[a-z0-9]{4,12}$"},
    "source_framework": {"const": "drupal_ai"},
    "recommendations": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["sequence", "target", "recommendation"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1, "maximum": 12},
          "target": {"$ref": "target.schema.json"},
          "recommendation": {"$ref": "recommendation.schema.json"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
