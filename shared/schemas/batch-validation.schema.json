{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "batch-validation.schema.json",
  "title": "Batch structured-output and deterministic-validation evidence",
  "$defs": {
    "result": {
      "type": "object",
      "required": ["sequence", "target", "structured_output_schema_valid", "deterministic_validation_passed", "errors"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1, "maximum": 12},
        "target": {"$ref": "target.schema.json"},
        "structured_output_schema_valid": {"type": "boolean"},
        "deterministic_validation_passed": {"type": "boolean"},
        "errors": {"type": "array", "items": {"type": "string", "maxLength": 500}}
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["schema_version", "run_id", "source_framework", "validator_version", "results"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^drupal_ai-[0-9]{8}T[0-9]{6}Z-[a-z0-9]{4,12}$"},
    "source_framework": {"const": "drupal_ai"},
    "validator_version": {"const": "gate05-validator-1.0.0"},
    "results": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/result"}
    }
  },
  "additionalProperties": false
}
