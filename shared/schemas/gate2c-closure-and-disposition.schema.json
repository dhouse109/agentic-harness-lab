      "required": ["step_2c02", "step_2c02_pass", "step_2c02_certified", "gate_2c", "gate_2c_pass", "gate_2c_certified", "gate_2", "gate_2_pass", "gate_2_exit_criteria_satisfied", "authoritative_three_framework_comparison_completed", "step_2c03_performed"],
