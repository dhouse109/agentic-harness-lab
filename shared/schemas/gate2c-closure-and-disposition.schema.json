    "corrected_environment_model_free_rehearsal": {"type": "object"},
    "framework_outcomes": {
      "type": "object",
      "required": ["langgraph", "crewai", "drupal_ai"],
      "additionalProperties": false,
      "properties": {
        "langgraph": {"type": "object"},
        "crewai": {"type": "object"},
        "drupal_ai": {"type": "object"}
      }
    },
    "lifecycle": {
