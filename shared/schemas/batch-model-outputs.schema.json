{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "batch-model-outputs.schema.json",
  "title": "Raw structured model-output evidence collection",
  "type": "object",
  "required": ["schema_version", "run_id", "framework_origin", "outputs"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^drupal_ai-[0-9]{8}T[0-9]{6}Z-[a-z0-9]{4,12}$"},
    "framework_origin": {"const": "drupal_ai"},
    "outputs": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["sequence", "target", "model_output"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1, "maximum": 12},
          "target": {"$ref": "target.schema.json"},
          "model_output": {"$ref": "drupal-ai-model-output.schema.json"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
