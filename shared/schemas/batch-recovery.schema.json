{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "batch-recovery.schema.json",
  "title": "Deterministic midpoint failure and resume evidence",
  "type": "object",
  "required": ["schema_version", "run_id", "source_framework", "failure_after_sequence", "failure_before_sequence", "completed_before_failure", "interrupted_at", "resumed_at", "resumed_with_run_id", "resumed_at_sequence", "duplicate_count", "completed_after_resume"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^drupal_ai-[0-9]{8}T[0-9]{6}Z-[a-z0-9]{4,12}$"},
    "source_framework": {"const": "drupal_ai"},
    "failure_after_sequence": {"const": 6},
    "failure_before_sequence": {"const": 7},
    "completed_before_failure": {
      "type": "array",
      "prefixItems": [{"const": 1}, {"const": 2}, {"const": 3}, {"const": 4}, {"const": 5}, {"const": 6}],
      "items": false,
      "minItems": 6,
      "maxItems": 6
    },
    "interrupted_at": {"type": "string", "format": "date-time"},
    "resumed_at": {"type": "string", "format": "date-time"},
    "resumed_with_run_id": {"type": "string", "pattern": "^drupal_ai-[0-9]{8}T[0-9]{6}Z-[a-z0-9]{4,12}$"},
    "resumed_at_sequence": {"const": 7},
    "duplicate_count": {"const": 0},
    "completed_after_resume": {
      "type": "array",
      "prefixItems": [{"const": 7}, {"const": 8}, {"const": 9}, {"const": 10}, {"const": 11}, {"const": 12}],
      "items": false,
      "minItems": 6,
      "maxItems": 6
    }
  },
  "additionalProperties": false
}
