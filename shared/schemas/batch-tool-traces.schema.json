{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "batch-tool-traces.schema.json",
  "title": "Sanitized shared-operation trace evidence",
  "type": "object",
  "required": ["schema_version", "run_id", "source_framework", "traces"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^drupal_ai-[0-9]{8}T[0-9]{6}Z-[a-z0-9]{4,12}$"},
    "source_framework": {"const": "drupal_ai"},
    "traces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["operation", "correlation_id", "started_at", "completed_at", "ok", "sequence", "result_sha256", "error"],
        "properties": {
          "operation": {"enum": ["find_images_needing_review", "get_image_context", "submit_recommendation", "get_recommendation_status"]},
          "correlation_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "started_at": {"type": "string", "format": "date-time"},
          "completed_at": {"type": "string", "format": "date-time"},
          "ok": {"type": "boolean"},
          "sequence": {"type": ["integer", "null"], "minimum": 1, "maximum": 12},
          "target": {"oneOf": [{"$ref": "target.schema.json"}, {"type": "null"}]},
          "result_sha256": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
          "recommendation_uuid": {"type": ["string", "null"], "format": "uuid"},
          "error": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "required": ["code", "message", "retryable"],
                "properties": {
                  "code": {"type": "string", "minLength": 1, "maxLength": 64},
                  "message": {"type": "string", "minLength": 1, "maxLength": 500},
                  "retryable": {"type": "boolean"}
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
