{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-harness-lab.local/schemas/gate2b-step03-adapter-evidence.schema.json",
  "title": "Gate 2B Step 2B.03 Adapter Evidence Summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "step",
    "status",
    "purpose",
    "accepted_claims",
    "nonclaims",
    "evidence_file_count"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "pattern": "^gate2b-step03-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$"},
    "step": {"const": "2B.03"},
    "status": {"enum": ["pass", "fail"]},
    "purpose": {"type": "string", "minLength": 1},
    "accepted_claims": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "nonclaims": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evidence_file_count": {"const": 11}
  }
}
