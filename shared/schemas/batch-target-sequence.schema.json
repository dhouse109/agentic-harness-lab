{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "batch-target-sequence.schema.json",
  "title": "Frozen 12-target batch sequence evidence",
  "type": "object",
  "required": ["schema_version", "target_sequence_sha256", "targets"],
  "properties": {
    "schema_version": {"const": 1},
    "target_sequence_sha256": {"const": "1f6132da02069f825cde52500242350e9ad6e85537c6c5407677e82d0e653728"},
    "targets": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {"$ref": "target.schema.json"}
    }
  },
  "additionalProperties": false
}
