{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "image-context.schema.json",
  "title": "Permitted image and page context",
  "description": "Only the facts permitted by EXPERIMENT_SPEC.md for one verified target.",
  "type": "object",
  "required": [
    "schema_version",
    "target",
    "article",
    "image",
    "existing_alt",
    "evidence_hash",
    "collected_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "target": {
      "$ref": "target.schema.json"
    },
    "article": {
      "type": "object",
      "required": [
        "title",
        "body_plain",
        "revision_id"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body_plain": {
          "type": "string"
        },
        "revision_id": {
          "type": "integer",
          "minimum": 1
        },
        "content_language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 16
        }
      },
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "required": [
        "file_uuid",
        "filename",
        "mime_type",
        "byte_length",
        "sha256",
        "representation"
      ],
      "properties": {
        "file_uuid": {
          "type": "string",
          "format": "uuid"
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "mime_type": {
          "type": "string",
          "pattern": "^image/"
        },
        "width": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "height": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "representation": {
          "description": "Step 16 selects exactly one kind for all framework runs.",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "enum": [
                "url",
                "data_url",
                "base64"
              ]
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "existing_alt": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
