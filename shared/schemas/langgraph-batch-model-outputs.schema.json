{
  "$id": "langgraph-batch-model-outputs.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "framework_origin": {
      "const": "langgraph"
    },
    "outputs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "model_output": {
            "$ref": "langgraph-model-output.schema.json"
          },
          "sequence": {
            "maximum": 12,
            "minimum": 1,
            "type": "integer"
          },
          "target": {
            "$ref": "target.schema.json"
          }
        },
        "required": [
          "sequence",
          "target",
          "model_output"
        ],
        "type": "object"
      },
      "maxItems": 12,
      "minItems": 12,
      "type": "array"
    },
    "run_id": {
      "pattern": "^langgraph-[0-9]{8}T[0-9]{6}Z-[a-z0-9]{4,12}$",
      "type": "string"
    },
    "schema_version": {
      "const": 1
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "framework_origin",
    "outputs"
  ],
  "title": "Raw structured model-output evidence collection",
  "type": "object"
}
