{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "batch-submissions.schema.json",
  "title": "Submitted recommendation evidence",
  "type": "object",
  "required": ["schema_version", "run_id", "framework_origin", "submissions"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^drupal_ai-[0-9]{8}T[0-9]{6}Z-[a-z0-9]{4,12}$"},
    "framework_origin": {"const": "drupal_ai"},
    "submissions": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["sequence", "target", "node_id", "uuid", "revision_id", "initial_status", "idempotent_replay_same_identity"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1, "maximum": 12},
          "target": {"$ref": "target.schema.json"},
          "node_id": {"type": "integer", "minimum": 1},
          "uuid": {"type": "string", "format": "uuid"},
          "revision_id": {"type": "integer", "minimum": 1},
          "initial_status": {"const": "pending"},
          "idempotent_replay_same_identity": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
