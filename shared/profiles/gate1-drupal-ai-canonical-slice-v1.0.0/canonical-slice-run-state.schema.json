{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gate1-drupal-ai-canonical-slice-run-state.schema.json",
  "title": "Gate 1 Drupal AI canonical-slice run state",
  "type": "object",
  "required": ["schema_version", "run_id", "framework_origin", "status", "provider", "model", "temperature", "prompt_version", "target_sequence_hash", "canonical_target", "model_call_count", "recommendation_identity", "started_at", "updated_at", "human_review_paused_at", "resumed_at", "completed_at", "failed_at", "aborted_at"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^drupal_ai-[0-9]{8}T[0-9]{6}Z-[a-z0-9]{4,12}$"},
    "framework_origin": {"const": "drupal_ai"},
    "status": {"enum": ["initialized", "running", "awaiting_human_review", "resuming", "completed", "failed", "aborted"]},
    "provider": {"const": "openai"},
    "model": {"const": "gpt-4.1-mini-2025-04-14"},
    "temperature": {"const": 0.0},
    "prompt_version": {"const": "drupal-ai-alt-text-v1.0.0"},
    "target_sequence_hash": {"const": "sha256:1f6132da02069f825cde52500242350e9ad6e85537c6c5407677e82d0e653728"},
    "canonical_target": {"$ref": "../../schemas/target.schema.json"},
    "model_call_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "recommendation_identity": {"type": ["object", "null"]},
    "wrapper_checkpoint": {"type": ["object", "null"], "description": "Pre-task/pre-image only; never post-image or post-model."},
    "started_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "human_review_paused_at": {"type": ["string", "null"], "format": "date-time"},
    "resumed_at": {"type": ["string", "null"], "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"},
    "failed_at": {"type": ["string", "null"], "format": "date-time"},
    "aborted_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "allOf": [
    {"properties": {"canonical_target": {"properties": {"sequence": {"const": 1}}, "required": ["sequence"]}}},
    {"if": {"properties": {"status": {"const": "completed"}}, "required": ["status"]}, "then": {"properties": {"completed_at": {"type": "string", "format": "date-time"}, "model_call_count": {"const": 1}}}}
  ],
  "additionalProperties": false
}
