{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tool-result.schema.json",
  "title": "Shared semantic tool result envelope",
  "type": "object",
  "required": [
    "schema_version",
    "tool_name",
    "ok",
    "timestamp",
    "correlation_id",
    "data",
    "error"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "tool_name": {
      "enum": [
        "find_images_needing_review",
        "get_image_context",
        "submit_recommendation",
        "get_recommendation_status"
      ]
    },
    "ok": {
      "type": "boolean"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "data": {
      "type": [
        "object",
        "null"
      ]
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "null"
          },
          "data": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ok": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "null"
          },
          "error": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          },
          "tool_name": {
            "const": "find_images_needing_review"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "targets",
              "total_count"
            ],
            "properties": {
              "targets": {
                "type": "array",
                "minItems": 12,
                "maxItems": 12,
                "items": {
                  "$ref": "target.schema.json"
                }
              },
              "total_count": {
                "const": 12
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          },
          "tool_name": {
            "const": "get_image_context"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "image-context.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          },
          "tool_name": {
            "const": "submit_recommendation"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "node_id",
              "uuid",
              "revision_id",
              "status",
              "source_framework",
              "run_id",
              "target"
            ],
            "properties": {
              "node_id": {
                "type": "integer",
                "minimum": 1
              },
              "uuid": {
                "type": "string",
                "format": "uuid"
              },
              "revision_id": {
                "type": "integer",
                "minimum": 1
              },
              "status": {
                "const": "pending"
              },
              "source_framework": {
                "enum": [
                  "drupal_ai",
                  "langgraph",
                  "crewai"
                ]
              },
              "run_id": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "$ref": "target.schema.json"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          },
          "tool_name": {
            "const": "get_recommendation_status"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "uuid",
              "revision_id",
              "status"
            ],
            "properties": {
              "uuid": {
                "type": "string",
                "format": "uuid"
              },
              "revision_id": {
                "type": "integer",
                "minimum": 1
              },
              "status": {
                "enum": [
                  "pending",
                  "approved",
                  "rejected"
                ]
              },
              "reviewer_username": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reviewed_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
